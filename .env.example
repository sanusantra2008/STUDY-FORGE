# ==============================================================================
# StudyForge AI — Environment Configuration Example
# ==============================================================================

# AI Provider Configuration ('google' or 'ollama')
AI_PROVIDER=google

# Google Gemini API Key (Required for cloud gemma-4-26b-a4b-it generation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it

# Local Ollama Provider Configuration (Optional for offline inference)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-secret-key-for-jwt-signing

# Database Configuration
# Leave blank for local SQLite (studyforge.db)
# For production PostgreSQL: postgresql://user:password@host:5432/studyforge
DATABASE_URL=

# CORS Allowed Origins (Comma-separated, or * for open access)
ALLOWED_ORIGINS=*

# Server Port & Storage Paths
PORT=8000
DATA_DIR=
UPLOADS_DIR=
